<UserControl x:Class="AppLauncher.Views.Controls.AppTileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="132" Height="140"
             Cursor="Hand"
             Focusable="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed">

    <Grid x:Name="RootGrid" Margin="3">
        <!-- Rounded Square Hover Background -->
        <Border x:Name="HoverBackground"
                CornerRadius="20"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                SnapsToDevicePixels="True"/>

        <!-- Main Card Content -->
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Margin="4,8,4,8">

            <!-- Pure Floating Native App Icon (Direct transparent image, 64x64) -->
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Grid x:Name="IconTransformContainer" 
                      RenderTransformOrigin="0.5, 0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IconScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Grid.RenderTransform>

                    <!-- Fallback generic icon -->
                    <TextBlock Text="🚀" 
                               FontSize="32" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Opacity="0.75"
                               Visibility="{Binding IconImage, Converter={StaticResource NullToVisibleConverter}}"/>

                    <!-- Pure High-Res Native App Icon (62x62 crisp) -->
                    <Image Source="{Binding IconImage}" 
                           Width="62" Height="62"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Aliased"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           Visibility="{Binding IconImage, Converter={StaticResource NotNullToVisibilityConverter}}"/>

                </Grid>
            </Grid>

            <!-- Enlarged High-Legibility Typography (FontSize: 13.5, Medium Weight) -->
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="#FAFFFFFF"
                       FontSize="13.5"
                       FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, sans-serif"
                       FontWeight="Medium"
                       TextOptions.TextFormattingMode="Display"
                       TextOptions.TextRenderingMode="ClearType"
                       TextOptions.TextHintingMode="Fixed"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxHeight="40"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       SnapsToDevicePixels="True"/>
        </StackPanel>
    </Grid>
</UserControl>
