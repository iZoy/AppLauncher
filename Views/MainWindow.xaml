<Window x:Class="AppLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AppLauncher.Views.Controls"
        xmlns:services="clr-namespace:AppLauncher.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="AppLauncher" 
        Height="600" Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated">

    <!-- DWM owns the rounded non-client surface on Windows 11 Acrylic mode. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared card and grid templates keep pinned, regular, and search views identical. -->
            <ItemsPanelTemplate x:Key="AppWrapPanelTemplate">
                <WrapPanel Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           ItemWidth="138"
                           ItemHeight="146"/>
            </ItemsPanelTemplate>

            <DataTemplate x:Key="AppTileTemplate">
                <Border Margin="1"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonUp="AppTile_MouseLeftButtonUp"
                        ContextMenuOpening="AppTile_ContextMenuOpening">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🚀 启动应用" Click="MenuLaunch_Click"/>
                            <MenuItem Header="🛡️ 以管理员身份运行" Click="MenuLaunchAdmin_Click"/>
                            <Separator/>
                            <MenuItem Header="📂 打开所在文件夹" Click="MenuOpenFolder_Click"/>
                            <MenuItem Header="📌 置顶" Click="MenuTogglePin_Click"/>
                            <MenuItem Header="✏️ 重命名显示名称" Click="MenuRename_Click"/>
                            <Separator/>
                            <MenuItem Header="🚫 从启动器中隐藏" Click="MenuHide_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <controls:AppTileControl/>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Single DWM-backed translucent panel; corners are clipped by the native Windows 11 surface. -->
    <Border x:Name="RootContainer"
            CornerRadius="0"
            Background="#8C222A34"
            BorderThickness="0"
            BorderBrush="Transparent"
            Opacity="1"
            Focusable="True"
            SnapsToDevicePixels="True">
        
        <!-- Global Context Menu for Blank Area -->
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="MenuAddApp" Header="➕ 添加软件 (选择 EXE / 快捷方式)..." Click="MenuAddApp_Click"/>
                <MenuItem x:Name="MenuAddFolder" Header="📁 扫描并添加软件文件夹..." Click="MenuAddFolder_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuRefreshList" Header="🔄 刷新应用列表" Click="MenuRefresh_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid x:Name="ContentLayer"
              Opacity="1"
              RenderTransformOrigin="0.5, 0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </Grid.RenderTransform>

            <Grid>
            <Grid.RowDefinitions>
                <!-- Top Header: Horizontal underline search bar -->
                <RowDefinition Height="50"/>
                <!-- Main Grid Area -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Search Line Area (Horizontal underline, NO separate rectangle box) -->
            <Grid Grid.Row="0" Margin="0,10,0,0" HorizontalAlignment="Center">
                <Grid.RenderTransform>
                    <!-- Nudge the underline, placeholder, and caret down together without moving the app grid. -->
                    <TranslateTransform Y="6"/>
                </Grid.RenderTransform>
                <Border Width="760" Height="36"
                        Background="Transparent"
                        BorderBrush="#45FFFFFF"
                        BorderThickness="0,0,0,1"
                        SnapsToDevicePixels="True">
                    <Grid Margin="2,0,2,2" VerticalAlignment="Center">
                        <!-- Watermark Placeholder "应用程序" in Gray (Shifted right to avoid caret overlap) -->
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="应用程序"
                                   Foreground="#80FFFFFF"
                                   FontSize="20"
                                   FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, sans-serif"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,2"
                                   IsHitTestVisible="False"
                                   Visibility="Visible"/>

                        <TextBox x:Name="SearchBox" 
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FFFFFFFF"
                                 CaretBrush="#FFFFFFFF"
                                 FontSize="20"
                                   FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, sans-serif"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Main App Grid with 120 FPS Physics Scroll (6 Apps per Row) -->
            <ScrollViewer Grid.Row="1" 
                          x:Name="MainScrollViewer"
                          services:SmoothScrollBehavior.IsSmoothScrollEnabled="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,4,18,18"
                          Focusable="False">

                <StackPanel x:Name="ScrollContent">
                    <!-- Browse mode: pinned apps, a scrolling divider, then regular apps. -->
                    <StackPanel x:Name="BrowseSectionsPanel">
                        <ItemsControl x:Name="PinnedAppsItemsControl"
                                      ItemTemplate="{StaticResource AppTileTemplate}"
                                      ItemsPanel="{StaticResource AppWrapPanelTemplate}"/>

                        <Border x:Name="PinnedDivider"
                                Width="760"
                                Height="1"
                                Margin="0,6,0,8"
                                HorizontalAlignment="Center"
                                Background="#45FFFFFF"
                                SnapsToDevicePixels="True"
                                Visibility="Collapsed"/>

                        <ItemsControl x:Name="RegularAppsItemsControl"
                                      ItemTemplate="{StaticResource AppTileTemplate}"
                                      ItemsPanel="{StaticResource AppWrapPanelTemplate}"/>
                    </StackPanel>

                    <!-- Search mode: one flat result list, including pinned apps. -->
                    <ItemsControl x:Name="SearchResultsItemsControl"
                                  ItemTemplate="{StaticResource AppTileTemplate}"
                                  ItemsPanel="{StaticResource AppWrapPanelTemplate}"
                                  Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty State -->
            <Grid Grid.Row="1" x:Name="EmptyStatePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="40" HorizontalAlignment="Center" Opacity="0.55"/>
                    <TextBlock x:Name="EmptyStateTitle" Text="未找到匹配的应用" Foreground="#85FFFFFF" FontSize="15" Margin="0,10,0,4" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateSubtitle" Text="右键空白处可手动添加软件" Foreground="#50FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
